+
+void BrowserCaptionButtonContainer::Layout(PassKey) {
+  LayoutSuperclass<views::View>(this);
+  if (frame_view_->ShouldUseAtlasTitlebar()) {
+    // Slide full-size controls into the clipped bar instead of squeezing their
+    // icons while the reserved non-client height grows from 3 to 32 DIPs.
+    for (views::View* button : children()) {
+      const gfx::Rect bounds = button->bounds();
+      button->SetBounds(bounds.x(), height() - 32, bounds.width(), 32);
+    }
+  }
+}
+
+void BrowserCaptionButtonContainer::AnimationProgressed(
+    const gfx::Animation* animation) {
   frame_view_->InvalidateLayout();
   frame_view_->GetBrowserView()->InvalidateLayout();
 }
 
+void BrowserCaptionButtonContainer::AnimationEnded(
+    const gfx::Animation* animation) {
+  UpdateButtons();
+  AnimationProgressed(animation);
+}
+
+void BrowserCaptionButtonContainer::AnimateAtlasTitlebar(bool reveal) {
+  atlas_caption_buttons_revealed_ = reveal;
+  atlas_titlebar_animation_.SetSlideDuration(
+      gfx::Animation::PrefersReducedMotion()
+          ? base::TimeDelta()
+          : gfx::Animation::RichAnimationDuration(
+                base::Milliseconds(reveal ? 180 : 160)));
+  atlas_titlebar_animation_.SetTweenType(gfx::Tween::EASE_IN_OUT);
+  if (reveal) {
+    atlas_titlebar_animation_.Show();
+  } else {
+    atlas_titlebar_animation_.Hide();
+  }
+  UpdateButtons();
+  AnimationProgressed(&atlas_titlebar_animation_);
+}
