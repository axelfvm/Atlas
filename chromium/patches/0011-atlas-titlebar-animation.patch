+IN_PROC_BROWSER_TEST_F(BrowserFrameViewWinInteractiveUiTest,
+                       AtlasTitlebarAnimationReversesWithoutJumping) {
+  auto render_mode = gfx::AnimationTestApi::SetRichAnimationRenderMode(
+      gfx::Animation::RichAnimationRenderMode::FORCE_ENABLED);
+  auto reduced_motion =
+      gfx::AnimationTestApi::SetPrefersReducedMotionForTesting(false);
+  gfx::ScopedAnimationDurationScaleMode duration_mode(
+      gfx::ScopedAnimationDurationScaleMode::NORMAL_DURATION);
+  auto* browser_view = BrowserView::GetBrowserViewForBrowser(browser());
+  auto* widget = browser_view->browser_widget();
+  auto* frame = static_cast<BrowserFrameViewWin*>(
+      widget->non_client_view()->frame_view());
+  tabs::VerticalTabStripStateController::From(browser())
+      ->SetVerticalTabsEnabled(true);
+  auto* caption = const_cast<BrowserCaptionButtonContainer*>(
+      frame->caption_button_container_for_testing());
+  widget->Maximize();
+  ASSERT_TRUE(base::test::RunUntil([&]() { return widget->IsMaximized(); }));
+  RunScheduledLayouts();
+
+  auto& animation = caption->atlas_titlebar_animation_for_testing();
+  animation.Reset();
+  static_cast<views::MouseWatcherListener*>(caption)->MouseMovedOutOfHost();
+  ui::MouseEvent entered(ui::EventType::kMouseEntered, gfx::PointF(20, 1),
+                         gfx::PointF(20, 1), base::TimeTicks::Now(), 0, 0);
+  static_cast<views::View*>(caption)->OnMouseEntered(entered);
+  gfx::AnimationTestApi clock(&animation);
+  const auto advance = [&](base::TimeDelta duration) {
+    const auto now = base::TimeTicks::Now();
+    clock.SetStartTime(now);
+    clock.Step(now + duration);
+    RunScheduledLayouts();
+    EXPECT_EQ(frame->GetBoundsForClientView().y(), caption->bounds().bottom());
+    for (views::View* button : caption->children()) {
+      if (button->GetVisible()) {
+        EXPECT_EQ(32, button->height());
+      }
+    }
+  };
+  advance(base::Milliseconds(70));
+  EXPECT_GT(caption->height(), 3);
+  EXPECT_LT(caption->height(), 32);
+  const double opening_value = animation.GetCurrentValue();
+  static_cast<views::MouseWatcherListener*>(caption)->MouseMovedOutOfHost();
+  EXPECT_DOUBLE_EQ(opening_value, animation.GetCurrentValue());
+  advance(base::Milliseconds(20));
+  EXPECT_LT(animation.GetCurrentValue(), opening_value);
+  const double closing_value = animation.GetCurrentValue();
+  static_cast<views::View*>(caption)->OnMouseEntered(entered);
+  EXPECT_DOUBLE_EQ(closing_value, animation.GetCurrentValue());
+  advance(base::Milliseconds(200));
+  EXPECT_EQ(32, caption->height());
+  static_cast<views::MouseWatcherListener*>(caption)->MouseMovedOutOfHost();
+  advance(base::Milliseconds(200));
+  EXPECT_EQ(3, caption->height());
+  for (views::View* button : caption->children()) {
+    EXPECT_FALSE(button->GetVisible());
+  }
+
+  // Restoring a window cancels a partially revealed maximized titlebar.
+  static_cast<views::View*>(caption)->OnMouseEntered(entered);
+  advance(base::Milliseconds(70));
+  widget->Restore();
+  ASSERT_TRUE(base::test::RunUntil([&]() { return !widget->IsMaximized(); }));
+  RunScheduledLayouts();
+  EXPECT_EQ(32, caption->height());
+  EXPECT_FALSE(animation.is_animating());
+}
