+IN_PROC_BROWSER_TEST_F(VerticalTabStripRegionViewTest,
+                       AtlasHoverUsesSavedWidthAndRevealsNavigation) {
+  auto* browser_view = BrowserView::GetBrowserViewForBrowser(browser());
+  auto* toolbar = browser_view->toolbar();
+  state_controller()->SetExpandOnHoverEnabled(true);
+
+  for (int expanded_width : {224, 240, 320, 400}) {
+    SCOPED_TRACE(expanded_width);
+    SetupExpandedVerticalTabStrip();
+    state_controller()->SetUncollapsedWidth(expanded_width);
+    state_controller()->RequestCollapse(true);
+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      return state_controller()->IsCollapsed() && !IsAnimatingSize();
+    }));
+    RunScheduledLayouts();
+    EXPECT_FALSE(toolbar->location_bar_view()->GetVisible());
+    const auto content_bounds =
+        browser_view->multi_contents_view()->GetBoundsInScreen();
+
+    auto keep_expanded = region_view()->GetExpandOnHoverLock(
+        ExpandOnHoverLockType::kKeepExpanded);
+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      return region_view()->is_expanded_on_hover() && !IsAnimatingSize();
+    }));
+    RunScheduledLayouts();
+    EXPECT_TRUE(state_controller()->IsCollapsed());
+    EXPECT_EQ(expanded_width, region_view()->width());
+    EXPECT_EQ(expanded_width, toolbar->width());
+    EXPECT_TRUE(toolbar->location_bar_view()->GetVisible());
+    EXPECT_EQ(content_bounds,
+              browser_view->multi_contents_view()->GetBoundsInScreen());
+
+    // A higher-priority lock models leaving the temporary panel without
+    // relying on the test machine's physical pointer position.
+    auto force_collapse = region_view()->GetExpandOnHoverLock(
+        ExpandOnHoverLockType::kForceCollapse);
+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      return !region_view()->is_expanded_on_hover() && !IsAnimatingSize();
+    }));
+    RunScheduledLayouts();
+    EXPECT_EQ(VerticalTabStripRegionView::kCollapsedWidth,
+              region_view()->width());
+    EXPECT_FALSE(toolbar->location_bar_view()->GetVisible());
+    EXPECT_EQ(expanded_width, state_controller()->GetUncollapsedWidth());
+    keep_expanded.reset();
+  }
+}
