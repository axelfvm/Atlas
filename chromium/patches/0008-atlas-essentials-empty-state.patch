+void VerticalTabStripRegionView::UpdateAtlasEssentialsState() {
+  const auto* model = tab_strip_model();
+  const bool has_essentials = model->IndexOfFirstNonPinnedTab() > 0;
+  atlas_essentials_label_->SetVisible(has_essentials);
+  atlas_add_essential_button_->SetText(has_essentials ? u""
+                                                      : u"Adicionar essencial");
+  atlas_add_essential_button_->SetHorizontalAlignment(
+      has_essentials ? gfx::ALIGN_CENTER : gfx::ALIGN_LEFT);
+  atlas_add_essential_button_->SetPreferredSize(
+      gfx::Size(has_essentials ? 32 : 0, 32));
+  atlas_add_essential_button_->SetProperty(
+      views::kFlexBehaviorKey,
+      views::FlexSpecification(views::LayoutOrientation::kHorizontal,
+                               views::MinimumFlexSizeRule::kPreferred,
+                               has_essentials
+                                   ? views::MaximumFlexSizeRule::kPreferred
+                                   : views::MaximumFlexSizeRule::kUnbounded));
+  const int active_index = model->active_index();
+  atlas_add_essential_button_->SetEnabled(model->ContainsIndex(active_index) &&
+                                          !model->IsTabPinned(active_index));
+}
+
+void VerticalTabStripRegionView::OnTabStripModelChanged(
+    TabStripModel* model,
+    const TabStripModelChange& change,
+    const TabStripSelectionChange& selection) {
+  UpdateAtlasEssentialsState();
+}
+
+void VerticalTabStripRegionView::OnTabPinnedStateChanged(
+    tabs::TabInterface* tab,
+    int index) {
+  UpdateAtlasEssentialsState();
+}
