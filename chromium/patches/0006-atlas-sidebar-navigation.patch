+      frame_view_->IsMaximized() &&
+      frame_view_->GetBrowserView()->ShouldDrawVerticalTabStrip();
+  const float opacity =
+      !should_auto_hide || atlas_caption_buttons_revealed_ ? 1.0f : 0.0f;
+  for (WindowsCaptionButton* button :
+       {minimize_button_, maximize_button_, restore_button_, close_button_}) {
+    button->layer()->SetOpacity(opacity);
