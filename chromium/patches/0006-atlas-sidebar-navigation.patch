+
+void ToolbarView::LayoutAtlasSidebarToolbar() {
+  constexpr int kOuterInset = 8;
+  constexpr int kControlGap = 4;
+  constexpr int kNavigationRowHeight = 44;
+  constexpr int kControlSize = 36;
+  constexpr int kOmniboxTop = 48;
+  constexpr int kOmniboxHeight = 40;
+  constexpr int kExpandedControlsMinimumWidth = 208;
+
+  // FlexLayout is intentionally bypassed in this mode. Clear the bounds of
+  // toolbar-only actions so they cannot overlap the page when the sidebar is
+  // narrow; they remain available from the Atlas menu and are restored by the
+  // regular layout if horizontal tabs are selected.
+  for (views::View* child : children()) {
+    child->SetBoundsRect(gfx::Rect());
+  }
+  // These controls use their own layers and can retain pixels after receiving
+  // empty bounds. Keep the Atlas header deterministic: profile/extensions live
+  // in the app menu, while the menu button itself is always the leading icon.
+  if (avatar_) {
+    avatar_->SetVisible(false);
+  }
+  if (overflow_button_) {
+    overflow_button_->SetVisible(false);
+  }
+
+  const auto* controller =
+      tabs::VerticalTabStripStateController::From(browser_);
+  const bool is_collapsed =
+      (controller && controller->IsCollapsed()) ||
+      width() < kExpandedControlsMinimumWidth;
+  if (app_menu_button_) {
+    app_menu_button_->SetVisible(!is_collapsed);
+  }
+  if (atlas_sidebar_toggle_button_) {
+    atlas_sidebar_toggle_button_->SetVisible(true);
+  }
+  if (back_) {
+    back_->SetVisible(!is_collapsed);
+  }
+  if (forward_) {
+    forward_->SetVisible(!is_collapsed && show_forward_button_.GetValue());
+  }
+  if (reload_) {
+    reload_->SetVisible(!is_collapsed);
+  }
+  location_bar_view_->SetVisible(!is_collapsed);
+
+  if (is_collapsed) {
+    if (atlas_sidebar_toggle_button_) {
+      atlas_sidebar_toggle_button_->SetBounds(
+          std::max(0, (width() - kControlSize) / 2),
+          (kAtlasSidebarCollapsedHeaderHeight - kControlSize) / 2,
+          kControlSize, kControlSize);
+    }
+    return;
+  }
+
+  const int button_y = (kNavigationRowHeight - kControlSize) / 2;
+  int leading = kOuterInset;
+  auto place_button = [&](views::View* button) {
+    if (!button || !button->GetVisible()) {
+      return;
+    }
+    button->SetBounds(leading, button_y, kControlSize, kControlSize);
+    leading += kControlSize + kControlGap;
+  };
+
+  place_button(app_menu_button_);
+  place_button(atlas_sidebar_toggle_button_);
+  place_button(back_);
+  place_button(forward_);
+  place_button(reload_);
+
+  const int omnibox_width = width() - 2 * kOuterInset;
+  location_bar_view_->SetBounds(kOuterInset, kOmniboxTop, omnibox_width,
+                                kOmniboxHeight);
+}
