+// Copyright 2026 The Atlas Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_WEBUI_SETTINGS_ATLAS_DRM_HANDLER_H_
+#define CHROME_BROWSER_UI_WEBUI_SETTINGS_ATLAS_DRM_HANDLER_H_
+
+#include "base/memory/weak_ptr.h"
+#include "base/values.h"
+#include "chrome/browser/ui/webui/settings/settings_page_ui_handler.h"
+
+namespace settings {
+
+// Handles local Widevine discovery and import for chrome://settings/drm.
+// Atlas never downloads or redistributes the proprietary CDM through this
+// handler; it only copies a user-selected installation already present on the
+// same computer.
+class AtlasDrmHandler : public SettingsPageUIHandler {
+ public:
+  AtlasDrmHandler();
+  AtlasDrmHandler(const AtlasDrmHandler&) = delete;
+  AtlasDrmHandler& operator=(const AtlasDrmHandler&) = delete;
+  ~AtlasDrmHandler() override;
+
+  // SettingsPageUIHandler:
+  void RegisterMessages() override;
+  void OnJavascriptAllowed() override {}
+  void OnJavascriptDisallowed() override;
+
+ private:
+  void HandleGetStatus(const base::ListValue& args);
+  void HandleDetectSources(const base::ListValue& args);
+  void HandleImport(const base::ListValue& args);
+  void HandleRemove(const base::ListValue& args);
+
+  void ResolveResult(base::Value callback_id, base::DictValue result);
+
+  base::WeakPtrFactory<AtlasDrmHandler> weak_ptr_factory_{this};
+};
+
+}  // namespace settings
+
+#endif  // CHROME_BROWSER_UI_WEBUI_SETTINGS_ATLAS_DRM_HANDLER_H_
diff --git a/chrome/browser/ui/webui/settings/atlas_drm_handler.cc b/chrome/browser/ui/webui/settings/atlas_drm_handler.cc
new file mode 100644
index 0000000000000..2cc6499ae3e1f
--- /dev/null
+++ b/chrome/browser/ui/webui/settings/atlas_drm_handler.cc
@@ -0,0 +1,333 @@
+// Copyright 2026 The Atlas Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/webui/settings/atlas_drm_handler.h"
+
+#include <optional>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "base/check.h"
+#include "base/files/file_enumerator.h"
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/functional/bind.h"
+#include "base/native_library.h"
+#include "base/path_service.h"
+#include "base/task/thread_pool.h"
+#include "base/values.h"
+#include "base/version.h"
+#include "build/build_config.h"
+#include "chrome/common/chrome_paths.h"
+#include "components/cdm/common/cdm_manifest.h"
+#include "content/public/browser/web_ui.h"
+#include "media/base/cdm_capability.h"
+#include "media/cdm/cdm_paths.h"
+#include "third_party/widevine/cdm/widevine_cdm_common.h"
+
+namespace settings {
+namespace {
+
+constexpr base::FilePath::CharType kAtlasManagedMarker[] =
+    FILE_PATH_LITERAL(".atlas-managed");
+
+struct DrmSource {
+  std::string id;
+  std::string name;
+  base::FilePath root;
+};
+
+struct ValidCdm {
+  base::Version version;
+  base::FilePath path;
+};
+
+base::FilePath GetAtlasWidevineRoot() {
+  base::FilePath user_data;
+  if (!base::PathService::Get(chrome::DIR_USER_DATA, &user_data)) {
+    return {};
+  }
+  return user_data.AppendASCII(kWidevineCdmBaseDirectory);
+}
+
+std::vector<DrmSource> GetKnownSources() {
+#if BUILDFLAG(IS_WIN)
+  base::FilePath local_app_data;
+  if (!base::PathService::Get(base::DIR_LOCAL_APP_DATA, &local_app_data)) {
+    return {};
+  }
+
+  return {
+      {"edge", "Microsoft Edge",
+       local_app_data.Append(FILE_PATH_LITERAL("Microsoft"))
+           .Append(FILE_PATH_LITERAL("Edge"))
+           .Append(FILE_PATH_LITERAL("User Data"))
+           .AppendASCII(kWidevineCdmBaseDirectory)},
+      {"chrome", "Google Chrome",
+       local_app_data.Append(FILE_PATH_LITERAL("Google"))
+           .Append(FILE_PATH_LITERAL("Chrome"))
+           .Append(FILE_PATH_LITERAL("User Data"))
+           .AppendASCII(kWidevineCdmBaseDirectory)},
+  };
+#else
+  return {};
+#endif
+}
+
+std::optional<ValidCdm> ValidateCdmDirectory(const base::FilePath& path) {
+  if (!base::DirectoryExists(path)) {
+    return std::nullopt;
+  }
+
+  const base::Version directory_version(path.BaseName().AsUTF8Unsafe());
+  if (!directory_version.IsValid()) {
+    return std::nullopt;
+  }
+
+  media::CdmCapability capability;
+  if (!ParseCdmManifestFromPath(path.Append(FILE_PATH_LITERAL("manifest.json")),
+                                &capability) ||
+      !capability.version.IsValid() ||
+      capability.version != directory_version) {
+    return std::nullopt;
+  }
+
+  const base::FilePath library =
+      media::GetPlatformSpecificDirectory(path).AppendASCII(
+          base::GetNativeLibraryName(kWidevineCdmLibraryName));
+  if (!base::PathExists(library)) {
+    return std::nullopt;
+  }
+
+#if BUILDFLAG(IS_WIN)
+  if (!base::PathExists(library.AddExtension(FILE_PATH_LITERAL(".sig")))) {
+    return std::nullopt;
+  }
+#endif
+
+  return ValidCdm{directory_version, path};
+}
+
+std::optional<ValidCdm> FindLatestValidCdm(const base::FilePath& root) {
+  if (!base::DirectoryExists(root)) {
+    return std::nullopt;
+  }
+
+  std::optional<ValidCdm> latest;
+  base::FileEnumerator directories(root, false,
+                                   base::FileEnumerator::DIRECTORIES);
+  for (base::FilePath path = directories.Next(); !path.empty();
+       path = directories.Next()) {
+    std::optional<ValidCdm> candidate = ValidateCdmDirectory(path);
+    if (candidate &&
+        (!latest || latest->version.CompareTo(candidate->version) < 0)) {
+      latest = std::move(candidate);
+    }
+  }
+  return latest;
+}
+
+base::DictValue ErrorResult(std::string code, std::string message) {
+  base::DictValue result;
+  result.Set("success", false);
+  result.Set("errorCode", std::move(code));
+  result.Set("message", std::move(message));
+  return result;
+}
+
+base::DictValue GetStatusOnWorker() {
+  base::DictValue result;
+  result.Set("success", true);
+  const std::optional<ValidCdm> installed =
+      FindLatestValidCdm(GetAtlasWidevineRoot());
+  result.Set("installed", installed.has_value());
+  if (installed) {
+    result.Set("version", installed->version.GetString());
+    result.Set("managed",
+               base::PathExists(installed->path.Append(kAtlasManagedMarker)));
+  } else {
+    result.Set("version", "");
+    result.Set("managed", false);
+  }
+  return result;
+}
+
+base::DictValue DetectSourcesOnWorker() {
+  base::ListValue sources;
+  for (const DrmSource& source : GetKnownSources()) {
+    const std::optional<ValidCdm> cdm = FindLatestValidCdm(source.root);
+    if (!cdm) {
+      continue;
+    }
+    base::DictValue item;
+    item.Set("id", source.id);
+    item.Set("name", source.name);
+    item.Set("version", cdm->version.GetString());
+    sources.Append(std::move(item));
+  }
+
+  base::DictValue result;
+  result.Set("success", true);
+  result.Set("sources", std::move(sources));
+  return result;
+}
+
+base::DictValue ImportOnWorker(std::string source_id) {
+  const auto sources = GetKnownSources();
+  const DrmSource* selected = nullptr;
+  for (const DrmSource& source : sources) {
+    if (source.id == source_id) {
+      selected = &source;
+      break;
+    }
+  }
+  if (!selected) {
+    return ErrorResult("unknown-source", "Fonte de DRM desconhecida.");
+  }
+
+  const std::optional<ValidCdm> source_cdm = FindLatestValidCdm(selected->root);
+  if (!source_cdm) {
+    return ErrorResult("invalid-source",
+                       "Nenhum componente Widevine válido foi encontrado.");
+  }
+
+  const base::FilePath destination_root = GetAtlasWidevineRoot();
+  if (destination_root.empty()) {
+    return ErrorResult("destination-unavailable",
+                       "O diretório de dados do Atlas não está disponível.");
+  }
+  if (!base::CreateDirectory(destination_root)) {
+    return ErrorResult("destination-unavailable",
+                       "Não foi possível preparar o diretório do Atlas.");
+  }
+
+  const base::FilePath destination =
+      destination_root.AppendASCII(source_cdm->version.GetString());
+  if (base::PathExists(destination)) {
+    if (!ValidateCdmDirectory(destination)) {
+      return ErrorResult(
+          "destination-conflict",
+          "Já existe uma instalação inválida com a mesma versão no Atlas.");
+    }
+  } else {
+    if (!base::CopyDirectory(source_cdm->path, destination, true) ||
+        !ValidateCdmDirectory(destination)) {
+      if (destination_root.IsParent(destination)) {
+        base::DeletePathRecursively(destination);
+      }
+      return ErrorResult("copy-failed",
+                         "Não foi possível copiar e validar o Widevine.");
+    }
+  }
+
+  if (!base::WriteFile(destination.Append(kAtlasManagedMarker), selected->id)) {
+    return ErrorResult(
+        "marker-failed",
+        "O componente foi copiado, mas não pôde ser gerenciado.");
+  }
+
+  base::DictValue result;
+  result.Set("success", true);
+  result.Set("version", source_cdm->version.GetString());
+  result.Set("sourceName", selected->name);
+  result.Set("restartRequired", true);
+  return result;
+}
+
+base::DictValue RemoveOnWorker(std::string version_string) {
+  const base::Version version(version_string);
+  if (!version.IsValid() || version.GetString() != version_string) {
+    return ErrorResult("invalid-version", "Versão de DRM inválida.");
+  }
+
+  const base::FilePath root = GetAtlasWidevineRoot();
+  const base::FilePath target = root.AppendASCII(version_string);
+  if (root.empty() || !root.IsParent(target) ||
+      !base::PathExists(target.Append(kAtlasManagedMarker))) {
+    return ErrorResult(
+        "not-managed",
+        "O Atlas só remove componentes importados por esta página.");
+  }
+  if (!base::DeletePathRecursively(target)) {
+    return ErrorResult("remove-failed",
+                       "Não foi possível remover o componente Widevine.");
+  }
+
+  base::DictValue result;
+  result.Set("success", true);
+  result.Set("restartRequired", true);
+  return result;
+}
+
+}  // namespace
+
+AtlasDrmHandler::AtlasDrmHandler() = default;
+AtlasDrmHandler::~AtlasDrmHandler() = default;
+
+void AtlasDrmHandler::RegisterMessages() {
+  web_ui()->RegisterMessageCallback(
+      "getAtlasDrmStatus",
+      base::BindRepeating(&AtlasDrmHandler::HandleGetStatus,
+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "detectAtlasDrmSources",
+      base::BindRepeating(&AtlasDrmHandler::HandleDetectSources,
+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "importAtlasDrm", base::BindRepeating(&AtlasDrmHandler::HandleImport,
+                                            base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "removeAtlasDrm", base::BindRepeating(&AtlasDrmHandler::HandleRemove,
+                                            base::Unretained(this)));
+}
+
+void AtlasDrmHandler::OnJavascriptDisallowed() {
+  weak_ptr_factory_.InvalidateWeakPtrs();
+}
+
+void AtlasDrmHandler::HandleGetStatus(const base::ListValue& args) {
+  AllowJavascript();
+  CHECK_EQ(args.size(), 1u);
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock()}, base::BindOnce(&GetStatusOnWorker),
+      base::BindOnce(&AtlasDrmHandler::ResolveResult,
+                     weak_ptr_factory_.GetWeakPtr(), args[0].Clone()));
+}
+
+void AtlasDrmHandler::HandleDetectSources(const base::ListValue& args) {
+  AllowJavascript();
+  CHECK_EQ(args.size(), 1u);
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock()}, base::BindOnce(&DetectSourcesOnWorker),
+      base::BindOnce(&AtlasDrmHandler::ResolveResult,
+                     weak_ptr_factory_.GetWeakPtr(), args[0].Clone()));
+}
+
+void AtlasDrmHandler::HandleImport(const base::ListValue& args) {
+  AllowJavascript();
+  CHECK_EQ(args.size(), 2u);
+  const std::string& source_id = args[1].GetString();
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock()}, base::BindOnce(&ImportOnWorker, source_id),
+      base::BindOnce(&AtlasDrmHandler::ResolveResult,
+                     weak_ptr_factory_.GetWeakPtr(), args[0].Clone()));
+}
+
+void AtlasDrmHandler::HandleRemove(const base::ListValue& args) {
+  AllowJavascript();
+  CHECK_EQ(args.size(), 2u);
+  const std::string& version = args[1].GetString();
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock()}, base::BindOnce(&RemoveOnWorker, version),
+      base::BindOnce(&AtlasDrmHandler::ResolveResult,
+                     weak_ptr_factory_.GetWeakPtr(), args[0].Clone()));
+}
+
+void AtlasDrmHandler::ResolveResult(base::Value callback_id,
+                                    base::DictValue result) {
+  ResolveJavascriptCallback(callback_id, result);
+}
+
+}  // namespace settings
diff --git a/chrome/browser/resources/settings/privacy_page/drm_browser_proxy.ts b/chrome/browser/resources/settings/privacy_page/drm_browser_proxy.ts
