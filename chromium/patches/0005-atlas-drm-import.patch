+<style include="cr-shared-style settings-shared cr-spinner-style">
+  .intro {
+    color: var(--cr-secondary-text-color);
+    font-size: 16px;
+    line-height: 1.5;
+    padding: 0 var(--cr-section-padding) 18px;
+  }
+
+  .card {
+    border: 1px solid var(--cr-separator-color);
+    border-radius: 12px;
+    margin: 0 var(--cr-section-padding) 18px;
+    overflow: hidden;
+  }
+
+  .card-header,
+  .source-row,
+  .message-row {
+    align-items: center;
+    display: flex;
+    gap: 16px;
+    min-height: 64px;
+    padding: 12px 16px;
+  }
+
+  .source-row + .source-row {
+    border-top: 1px solid var(--cr-separator-color);
+  }
+
+  .grow {
+    flex: 1;
+    min-width: 0;
+  }
+
+  .primary {
+    font-size: 16px;
+    font-weight: 500;
+  }
+
+  .secondary {
+    color: var(--cr-secondary-text-color);
+    font-size: 14px;
+    line-height: 1.45;
+    margin-top: 4px;
+  }
+
+  .message-row {
+    background: var(--cr-card-background-color);
+    margin: 0 var(--cr-section-padding) 18px;
+  }
+
+  .message-row.error {
+    color: var(--google-red-700);
+  }
+
+  .legal {
+    color: var(--cr-secondary-text-color);
+    font-size: 13px;
+    line-height: 1.5;
+    padding: 0 var(--cr-section-padding) 24px;
+  }
+
+  h2 {
+    margin: 0;
+    padding: 0 var(--cr-section-padding) 8px;
+  }
+
+  .spinner {
+    flex: none;
+  }
+</style>
+
+<settings-subpage page-title="$i18n{atlasDrmPageTitle}"
+    route-path$="[[routePath]]">
+  <div class="intro">$i18n{atlasDrmPageDescription}</div>
+
+  <div class="card">
+    <div class="card-header">
+      <div class="grow">
+        <div class="primary">$i18n{atlasDrmStatusTitle}</div>
+        <div class="secondary">[[getInstalledLabel_(status_)]]</div>
+      </div>
+      <div class="spinner" hidden$="[[!busy_]]"></div>
+      <cr-button hidden$="[[!status_.managed]]" disabled="[[busy_]]"
+          on-click="onRemoveClick_">
+        $i18n{atlasDrmRemoveButton}
+      </cr-button>
+    </div>
+  </div>
+
+  <cr-link-row class="hr" label="$i18n{atlasDrmProtectedContentTitle}"
+      sub-label="$i18n{atlasDrmProtectedContentDescription}"
+      on-click="onProtectedContentClick_"
+      role-description="$i18n{subpageArrowRoleDescription}">
+  </cr-link-row>
+
+  <h2>$i18n{atlasDrmSourcesTitle}</h2>
+  <div class="card">
+    <template is="dom-repeat" items="[[sources_]]">
+      <div class="source-row">
+        <div class="grow">
+          <div class="primary">[[item.name]]</div>
+          <div class="secondary">
+            $i18n{atlasDrmDetectedVersion} [[item.version]]
+          </div>
+        </div>
+        <cr-button class="action-button" disabled="[[busy_]]"
+            data-source-id$="[[item.id]]" on-click="onImportClick_">
+          $i18n{atlasDrmImportButton}
+        </cr-button>
+      </div>
+    </template>
+    <div class="source-row" hidden$="[[sources_.length]]">
+      <div class="secondary">$i18n{atlasDrmNoSources}</div>
+    </div>
+  </div>
+
+  <div class$="[[messageClass_(isError_)]]" hidden$="[[!message_]]">
+    <div class="grow">[[message_]]</div>
+    <cr-button class="action-button" hidden$="[[!restartRequired_]]"
+        on-click="onRestartClick_">
+      $i18n{atlasDrmRestartButton}
+    </cr-button>
+  </div>
+
+  <div class="legal">$i18n{atlasDrmLegalNotice}</div>
+</settings-subpage>

