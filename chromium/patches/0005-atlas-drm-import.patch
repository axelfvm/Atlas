@@ -0,0 +1,76 @@
+// Copyright 2026 The Atlas Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import {sendWithPromise} from 'chrome://resources/js/cr.js';
+
+export interface AtlasDrmStatus {
+  success: boolean;
+  installed: boolean;
+  version: string;
+  managed: boolean;
+  errorCode?: string;
+  message?: string;
+}
+
+export interface AtlasDrmSource {
+  id: string;
+  name: string;
+  version: string;
+}
+
+export interface AtlasDrmSourcesResult {
+  success: boolean;
+  sources: AtlasDrmSource[];
+  errorCode?: string;
+  message?: string;
+}
+
+export interface AtlasDrmActionResult {
+  success: boolean;
+  version?: string;
+  sourceName?: string;
+  restartRequired?: boolean;
+  errorCode?: string;
+  message?: string;
+}
+
+export interface AtlasDrmBrowserProxy {
+  getStatus(): Promise<AtlasDrmStatus>;
+  detectSources(): Promise<AtlasDrmSourcesResult>;
+  importFrom(sourceId: string): Promise<AtlasDrmActionResult>;
+  remove(version: string): Promise<AtlasDrmActionResult>;
+  restart(): void;
+}
+
+export class AtlasDrmBrowserProxyImpl implements AtlasDrmBrowserProxy {
+  getStatus() {
+    return sendWithPromise<AtlasDrmStatus>('getAtlasDrmStatus');
+  }
+
+  detectSources() {
+    return sendWithPromise<AtlasDrmSourcesResult>('detectAtlasDrmSources');
+  }
+
+  importFrom(sourceId: string) {
+    return sendWithPromise<AtlasDrmActionResult>('importAtlasDrm', sourceId);
+  }
+
+  remove(version: string) {
+    return sendWithPromise<AtlasDrmActionResult>('removeAtlasDrm', version);
+  }
+
+  restart() {
+    chrome.send('restart');
+  }
+
+  static getInstance(): AtlasDrmBrowserProxy {
+    return instance || (instance = new AtlasDrmBrowserProxyImpl());
+  }
+
+  static setInstance(obj: AtlasDrmBrowserProxy) {
+    instance = obj;
+  }
+}
+
+let instance: AtlasDrmBrowserProxy|null = null;
diff --git a/chrome/browser/resources/settings/privacy_page/drm_page.ts b/chrome/browser/resources/settings/privacy_page/drm_page.ts
new file mode 100644
index 0000000000000..cefa27bc25151
--- /dev/null
+++ b/chrome/browser/resources/settings/privacy_page/drm_page.ts
@@ -0,0 +1,189 @@
+// Copyright 2026 The Atlas Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import 'chrome://resources/cr_elements/cr_button/cr_button.js';
+import 'chrome://resources/cr_elements/cr_link_row/cr_link_row.js';
+import 'chrome://resources/cr_elements/cr_spinner_style.css.js';
+import 'chrome://resources/cr_elements/cr_shared_style.css.js';
+import '../settings_page/settings_subpage.js';
+import '../settings_shared.css.js';
+
+import {I18nMixin} from 'chrome://resources/cr_elements/i18n_mixin.js';
+import {PolymerElement} from 'chrome://resources/polymer/v3_0/polymer/polymer_bundled.min.js';
+
+import {routes} from '../route.js';
+import {Router} from '../router.js';
+import {SettingsViewMixin} from '../settings_page/settings_view_mixin.js';
+
+import type {AtlasDrmActionResult, AtlasDrmBrowserProxy, AtlasDrmSource, AtlasDrmStatus} from './drm_browser_proxy.js';
+import {AtlasDrmBrowserProxyImpl} from './drm_browser_proxy.js';
+import {getTemplate} from './drm_page.html.js';
+
+const SettingsDrmPageElementBase = SettingsViewMixin(I18nMixin(PolymerElement));
+
+export class SettingsDrmPageElement extends SettingsDrmPageElementBase {
+  static get is() {
+    return 'settings-drm-page';
+  }
+
+  static get template() {
+    return getTemplate();
+  }
+
+  static get properties() {
+    return {
+      status_: Object,
+      sources_: {
+        type: Array,
+        value: () => [],
+      },
+      busy_: {
+        type: Boolean,
+        value: false,
+      },
+      restartRequired_: {
+        type: Boolean,
+        value: false,
+      },
+      message_: {
+        type: String,
+        value: '',
+      },
+      isError_: {
+        type: Boolean,
+        value: false,
+      },
+    };
+  }
+
+  declare private status_: AtlasDrmStatus|undefined;
+  declare private sources_: AtlasDrmSource[];
+  declare private busy_: boolean;
+  declare private restartRequired_: boolean;
+  declare private message_: string;
+  declare private isError_: boolean;
+
+  private browserProxy_: AtlasDrmBrowserProxy =
+      AtlasDrmBrowserProxyImpl.getInstance();
+
+  override connectedCallback() {
+    super.connectedCallback();
+    void this.refresh_();
+  }
+
+  private async refresh_() {
+    this.busy_ = true;
+    this.message_ = '';
+    try {
+      const [status, sources] = await Promise.all([
+        this.browserProxy_.getStatus(),
+        this.browserProxy_.detectSources(),
+      ]);
+      this.status_ = status;
+      this.sources_ = sources.sources || [];
+      if (!status.success || !sources.success) {
+        this.showError_(
+            status.message || sources.message ||
+            this.i18n('atlasDrmGenericError'));
+      }
+    } catch (_error) {
+      this.showError_(this.i18n('atlasDrmGenericError'));
+    } finally {
+      this.busy_ = false;
+    }
+  }
+
+  private async onImportClick_(event: Event) {
+    const sourceId = (event.currentTarget as HTMLElement).dataset['sourceId'];
+    if (!sourceId) {
+      return;
+    }
+    this.busy_ = true;
+    this.message_ = '';
+    try {
+      const result = await this.browserProxy_.importFrom(sourceId);
+      if (!result.success) {
+        this.showError_(result.message || this.i18n('atlasDrmGenericError'));
+        return;
+      }
+      this.restartRequired_ = Boolean(result.restartRequired);
+      this.showSuccess_(this.i18n(
+          'atlasDrmImportSuccess', result.version || '',
+          result.sourceName || ''));
+      await this.reloadStatus_();
+    } catch (_error) {
+      this.showError_(this.i18n('atlasDrmGenericError'));
+    } finally {
+      this.busy_ = false;
+    }
+  }
+
+  private async onRemoveClick_() {
+    if (!this.status_?.managed || !this.status_.version) {
+      return;
+    }
+    this.busy_ = true;
+    this.message_ = '';
+    try {
+      const result: AtlasDrmActionResult =
+          await this.browserProxy_.remove(this.status_.version);
+      if (!result.success) {
+        this.showError_(result.message || this.i18n('atlasDrmGenericError'));
+        return;
+      }
+      this.restartRequired_ = Boolean(result.restartRequired);
+      this.showSuccess_(this.i18n('atlasDrmRemoveSuccess'));
+      await this.reloadStatus_();
+    } catch (_error) {
+      this.showError_(this.i18n('atlasDrmGenericError'));
+    } finally {
+      this.busy_ = false;
+    }
+  }
+
+  private async reloadStatus_() {
+    this.status_ = await this.browserProxy_.getStatus();
+  }
+
+  private onProtectedContentClick_() {
+    Router.getInstance().navigateTo(routes.SITE_SETTINGS_PROTECTED_CONTENT);
+  }
+
+  private onRestartClick_() {
+    this.browserProxy_.restart();
+  }
+
+  private showError_(message: string) {
+    this.isError_ = true;
+    this.message_ = message;
+  }
+
+  private showSuccess_(message: string) {
+    this.isError_ = false;
+    this.message_ = message;
+  }
+
+  private messageClass_(isError: boolean): string {
+    return isError ? 'message-row error' : 'message-row';
+  }
+
+  private getInstalledLabel_(status?: AtlasDrmStatus): string {
+    return status?.installed ?
+        this.i18n('atlasDrmInstalledVersion', status.version) :
+        this.i18n('atlasDrmNotInstalled');
+  }
+
+  // SettingsViewMixin implementation.
+  override focusBackButton() {
+    this.shadowRoot!.querySelector('settings-subpage')!.focusBackButton();
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'settings-drm-page': SettingsDrmPageElement;
+  }
+}
+
+customElements.define(SettingsDrmPageElement.is, SettingsDrmPageElement);
