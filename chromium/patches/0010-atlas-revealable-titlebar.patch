+IN_PROC_BROWSER_TEST_F(BrowserFrameViewWinInteractiveUiTest,
+                       AtlasTitlebarReservesSpaceAndKeepsNativeDragRegion) {
+  auto* browser_view = BrowserView::GetBrowserViewForBrowser(browser());
+  auto* frame = static_cast<BrowserFrameViewWin*>(browser_view->GetFrameView());
+  auto* widget = browser_view->browser_widget();
+  tabs::VerticalTabStripStateController::From(browser())
+      ->SetVerticalTabsEnabled(true);
+  auto* caption = const_cast<BrowserCaptionButtonContainer*>(
+      frame->caption_button_container_for_testing());
+
+  widget->Restore();
+  ASSERT_TRUE(base::test::RunUntil([&]() { return !widget->IsMaximized(); }));
+  RunScheduledLayouts();
+  EXPECT_EQ(32, caption->height());
+  EXPECT_EQ(frame->GetBoundsForClientView().y(), caption->bounds().bottom());
+  EXPECT_EQ(HTCAPTION, caption->NonClientHitTest(gfx::Point(20, 16)));
+
+  widget->Maximize();
+  ASSERT_TRUE(base::test::RunUntil([&]() { return widget->IsMaximized(); }));
+  // Exercise the callbacks without depending on the physical mouse position.
+  static_cast<views::MouseWatcherListener*>(caption)->MouseMovedOutOfHost();
+  RunScheduledLayouts();
+  EXPECT_EQ(3, caption->height());
+  EXPECT_EQ(HTCLIENT, caption->NonClientHitTest(gfx::Point(20, 1)));
+  for (auto* button : caption->children()) {
+    EXPECT_FALSE(button->GetVisible());
+  }
+
+  ui::MouseEvent entered(ui::EventType::kMouseEntered, gfx::PointF(20, 1),
+                         gfx::PointF(20, 1), base::TimeTicks::Now(), 0, 0);
+  static_cast<views::View*>(caption)->OnMouseEntered(entered);
+  RunScheduledLayouts();
+  EXPECT_EQ(32, caption->height());
+  EXPECT_EQ(frame->GetBoundsForClientView().y(), caption->bounds().bottom());
+  EXPECT_EQ(HTCAPTION, caption->NonClientHitTest(gfx::Point(20, 16)));
+
+  static_cast<views::MouseWatcherListener*>(caption)->MouseMovedOutOfHost();
+  RunScheduledLayouts();
+  EXPECT_EQ(3, caption->height());
+  widget->Restore();
+  ASSERT_TRUE(base::test::RunUntil([&]() { return !widget->IsMaximized(); }));
+  RunScheduledLayouts();
+  EXPECT_EQ(32, caption->height());
+  EXPECT_EQ(frame->GetBoundsForClientView().y(), caption->bounds().bottom());
+}
